# Copy to .env.dev / .env.staging / .env.prod and fill in real values.
# These per-environment files are gitignored — never commit real credentials.
# Key names below MUST match api/config.ts exactly (it reads these via requireEnv()) —
# see .env.dev for the full set of real internal service hostnames.
#
# All service-URL keys use the EMS_ prefix — matching magpie's application-*.properties
# naming exactly, so values can be copied straight across without renaming.

BASE_URL=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

EMS_UI_GATEWAY_SERVICE_URL=
EMS_AUTHENTICATION_SERVICE_URL=
EMS_API_GATEWAY_SERVICE_URL=
EMS_INPUT_CONFIG_MAPPING_SERVICE_URL=
# Backs Flow endpoints (magpie: OrchestrationConfigServiceClient) — not a separate "flow service".
EMS_ORCHESTRATION_CONFIG_SERVICE_URL=
EMS_INPUT_CORE_SERVICE_URL=
EMS_TRACK_SERVICE_URL=
EMS_CONFIGURATION_SERVICE_URL=
EMS_REPORTING_SERVICE_URL=

# Optional — only set these if you need to override the defaults baked into api/config.ts
# ('/auth/login' and '/auth/user_info').
# AUTH_LOGIN_PATH=
# AUTH_USER_INFO_PATH=

# Optional — sent as x-workspace on every internally-authenticated request that doesn't pass
# its own workspaceCode. None of the current specs rely on this (each creates its own
# workspace/connection), so it's fine to leave blank.
EMS_QA_WORKSPACE_CODE=
EMS_QA_CONNECTION_CODE=

# Defaults to 'DRAFT' in api/config.ts if unset — override to 'LIVE' for tests that
# specifically need to hit the live edition path.
EDITION=DRAFT

# Identity used to build the internal x-user-info trust header when a test doesn't pass its
# own `email` to internalHeaders(...). Not a real credential — just an identity label.
EMS_TEST_IDENTITY_EMAIL=qa-automation@almosafer.com

# Optional — overrides the permanent trigger-event code that fixtures/hybrid.fixture.ts's
# `seededFlow` fixture falls back to (a fixed dev-only code baked into that file). Set this
# per environment if staging/prod use a different permanent trigger event.
# FLOW_TRIGGER_EVENT_CODE=

# Optional — display names for workspace switching in UI regression tests (E2E-08).
# EMS_QA_WORKSPACE_NAME=drahem-workspace
# EMS_QA_OTHER_WORKSPACE_NAME=OMS

# Optional — browser viewport for UI tests (default 1920×1080). EMS sidebar collapses below
# ~1400px width; raise these if your monitor is larger and you run headed.
# PLAYWRIGHT_VIEWPORT_WIDTH=1920
# PLAYWRIGHT_VIEWPORT_HEIGHT=1080
